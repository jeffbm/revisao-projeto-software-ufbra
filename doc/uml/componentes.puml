@startuml
package "Interface web" {
  [Painéis e formulários] as UI
}
package "HTTP / Express" {
  [Auth middleware] as AUTH
  [Rotas API] as API
}
package "Aplicação" {
  [OficinaService] as OF
  [AutenticacaoService] as AS
  [Serviços V1] as SV
  [AuditoriaService] as AU
}
package "Domínio" {
  [Cliente / Veiculo / OS / Peca] as DOM
}
package "Persistência" {
  [Repositórios V1] as REPO
  [GestaoRepository] as GR
  database "SQLite" as DB
}
UI --> API : HTTP / JSON
API --> AUTH
AUTH --> AS
API --> OF
OF --> SV
OF --> GR
OF --> AU
OF --> DB : transação
SV --> DOM
SV --> REPO
SV --> AU
AS --> REPO
AU --> REPO
REPO --> DB
GR --> DB
@enduml
